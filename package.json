{
  "name": "fieldnote-wifi-mapper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local Wi-Fi survey tool with real macOS signal readings.",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "node scripts/build-native.mjs && node server/index.mjs --dev",
    "build": "tsc --noEmit && vite build && node scripts/build-native.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.* server/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
